        "domain_enum": [
          "paysim",
          "ieee_cis"
        ],
        "transaction_required": [
          "transaction_id",
          "amount",
          "currency",
          "channel"
        ],
        "transaction_optional": [
          "product_code",
          "card_network",
          "funding_type"
        ],
        "context_optional": [
          "source"
        ],
        "payload_by_domain": {
          "paysim": {
            "required": [
              "step",
              "type",
              "nameOrig",
              "nameDest",
              "oldbalanceOrg"
            ],
            "optional": [
              "newbalanceOrig",
              "oldbalanceDest",
              "newbalanceDest"
            ]
          },
          "ieee_cis": {
            "required": [
              "TransactionDT",
              "TransactionAmt",
              "ProductCD",
              "card1",
              "card2",
              "card3",
              "card5",
              "addr1",
              "addr2"
            ],
            "optional": [
              "card4",
              "card6",
              "dist1",
              "P_emaildomain",
              "R_emaildomain",
              "DeviceType",
              "DeviceInfo",
              "id_30",
              "id_31",
              "id_33",
              "identity_present"
            ]
          }
        }
      },
      "response": {
        "top_level_required": [
          "request_id",
          "status",
          "domain",
          "transaction_id",
          "input_snapshot",
          "risk",
          "scores",
          "signals",
          "explanations",
          "features",
          "alerts",
          "transaction_summary",
          "model",
          "latency_ms"
        ],
        "status_enum": [
          "ok",
          "error"
        ],
        "risk": {
          "required": [
            "score",
            "level",
            "decision",
            "confidence"
          ],
          "level_enum": [
            "low",
            "medium",
            "high"
          ],
          "decision_enum": [
            "allow",
            "review",
            "block"
          ]
        },
        "input_snapshot": {
          "required": [
            "transaction",
            "payload"
          ],
          "description": "Echo of the request fields used for scoring so the frontend can display raw input values without separate mapping."
        },
        "scores": {
          "required": [
            "heuristic",
            "supervised",
            "anomaly",
            "fusion_version"
          ],
          "nullable_fields": [
            "supervised",
            "anomaly"
          ]
        },
        "signal_object": {
          "required": [
            "code",
            "severity",
            "value",
            "threshold",
            "message"
          ],
          "severity_enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "explanations": {
          "required": [
            "top_reasons",
            "feature_contributions"
          ],
          "feature_contribution_object": {
            "required": [
              "feature",
              "value",
              "impact"
            ]
          }
        },
        "alerts": {
          "alert_object_required": [
            "alert_id",
            "type",
            "priority",
            "status",
            "recommended_action"
          ],
          "priority_enum": [
            "low",
            "medium",
            "high"
          ],
          "status_enum": [
            "open",
            "resolved",
            "dismissed"
          ]
        },
        "model": {
          "required": [
            "artifact_version",
            "mode",
            "engine_version"
          ],
          "mode_enum": [
            "heuristic_only",
            "model_plus_rules"
          ]
        },
        "feature_keys_by_domain": {
          "paysim": [
            "type_risk_flag",
            "amount_to_orig_balance_ratio",
            "orig_balance_consistency_error",
            "sender_txn_count_24h",
            "sender_amount_zscore_7d",
            "sender_dest_pair_novelty"
          ],
          "ieee_cis": [
            "uid_prior_frequency",
            "amt_to_uid_median_ratio",
            "uid_txn_count_24h",
            "email_domain_mismatch",
            "new_device_for_uid",
            "identity_present"
          ]
        }
      }
    },
    "batch": {
      "method": "POST",
      "path": "/v1/batch",
      "request_shape": {
        "required": [
          "domain",
          "items"
        ]
      },
      "response_shape": {
        "required": [
          "domain",
          "results"
        ],
        "result_item": "Same as /v1/score response object"
      }
    },
    "alerts": {
      "method": "GET",
      "path": "/v1/alerts",
      "response_shape": {
        "required": [
          "items"
        ]
      }
    },
    "health": {
      "method": "GET",
      "path": "/v1/health"
    },
    "admin_models": {
      "method": "GET",
      "path": "/v1/admin/models"
    }
  },
